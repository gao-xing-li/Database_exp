        <mxCell id="legend_panel" value="" style="rounded=0;fillColor=#f6f8fb;strokeColor=#c4ceda;" parent="1" vertex="1">
          <mxGeometry x="96.0" y="3680.0" width="2944.0" height="536.0" as="geometry"/>
        </mxCell>
        <mxCell id="legend_0" value="图例：矩形为实体，菱形为联系；下划线为主码（多项合为联合主码）；AK / 同组 AK1 为候选码辅助标记。" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Microsoft YaHei;fontSize=24;fontColor=#22334a;fontStyle=0;" parent="1" vertex="1">
          <mxGeometry x="128.0" y="3697.6000000000004" width="2880.0" height="44.800000000000004" as="geometry"/>
        </mxCell>
        <mxCell id="legend_1" value="? 为原字段可空；/ 为派生属性；本端参与次数：1..1 恰好一次，0..1 可选一次，0..* 可选多次，1..* 至少一次。" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Microsoft YaHei;fontSize=24;fontColor=#22334a;fontStyle=0;" parent="1" vertex="1">
          <mxGeometry x="128.0" y="3745.6000000000004" width="2880.0" height="44.800000000000004" as="geometry"/>
        </mxCell>
        <mxCell id="legend_2" value="N 为条件附注；U1 为已验证的采购限制；Δ2 为整单到货仍有流程缺口。其他说明见本周数据字典。" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Microsoft YaHei;fontSize=24;fontColor=#22334a;fontStyle=0;" parent="1" vertex="1">
          <mxGeometry x="128.0" y="3793.6000000000004" width="2880.0" height="44.800000000000004" as="geometry"/>
        </mxCell>
        <mxCell id="note_N04_0" value="N04  SPOT 可无会员且不关联预订；PRESALE 必须关联同会员预订，整体提货。" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Microsoft YaHei;fontSize=24;fontColor=#34485e;fontStyle=0;" parent="1" vertex="1">
          <mxGeometry x="128.0" y="3867.2000000000003" width="2816.0" height="41.6" as="geometry"/>
        </mxCell>
        <mxCell id="note_N05_0" value="N05  U1 同活动最多一张采购单；预售单关联活动，普通补货不关联。三项限制见本周字典。" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Microsoft YaHei;fontSize=24;fontColor=#945400;fontStyle=0;" parent="1" vertex="1">
          <mxGeometry x="128.0" y="3920.0" width="2816.0" height="41.6" as="geometry"/>
        </mxCell>
        <mxCell id="note_N06_0" value="N06  Δ2 部分到货状态已移除；received_qty 保留，数量与整单状态一致性未强制。" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Microsoft YaHei;fontSize=24;fontColor=#945400;fontStyle=0;" parent="1" vertex="1">
          <mxGeometry x="128.0" y="3972.8" width="2816.0" height="41.6" as="geometry"/>
        </mxCell>
        <mxCell id="note_N07_0" value="N07  实际采购与验收有明细；预售单明细商品匹配活动，普通补货可多商品。" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Microsoft YaHei;fontSize=24;fontColor=#34485e;fontStyle=0;" parent="1" vertex="1">
          <mxGeometry x="128.0" y="4025.6000000000004" width="2816.0" height="41.6" as="geometry"/>
        </mxCell>
        <mxCell id="local_scope" value="本局部图省略员工关联 R12 / R18 / R19；完整人员联系见总图。" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Microsoft YaHei;fontSize=24;fontColor=#52647b;fontStyle=0;" parent="1" vertex="1">
